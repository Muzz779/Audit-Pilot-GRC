# AuditPilot environment variables.
# Copy to .env.local for local dev (already gitignored) and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit real values. The service-role key bypasses RLS — keep it secret.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only, bypasses RLS

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-6                 # optional; this is the default

# ── Voyage AI (embeddings) ──────────────────────────────────────────────────
VOYAGE_API_KEY=your-voyage-key

# ── Cost guard ──────────────────────────────────────────────────────────────
STARTER_AI_MONTHLY_CAP=100                        # optional; free-tier monthly AI-op cap

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain

# ── PayFast (billing, ZAR) ──────────────────────────────────────────────────
NEXT_PUBLIC_PAYFAST_MERCHANT_ID=your-merchant-id
NEXT_PUBLIC_PAYFAST_MERCHANT_KEY=your-merchant-key
NEXT_PUBLIC_PAYFAST_SANDBOX=true                  # true in sandbox, false when live
PAYFAST_PASSPHRASE=your-passphrase                # SECRET — server only
